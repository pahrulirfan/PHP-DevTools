server {
    listen {{ http_port }};
{% if https %}
    listen {{ https_port }} ssl{% if not http2_directive %} http2{% endif %};
{% if http2_directive %}
    http2 on;
{% endif %}
    ssl_certificate     {{ cert }};
    ssl_certificate_key {{ key }};
{% endif %}

    server_name {{ name }}.{{ tld }};
    root {{ docroot }};
    index index.php index.html;
    charset utf-8;
    client_max_body_size {{ upload_max }};

    access_log {{ log_dir }}/{{ name }}-access.log;
    error_log  {{ log_dir }}/{{ name }}-error.log;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include {{ etc_nginx }}/fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT   $realpath_root;
        fastcgi_pass unix:{{ php_socket }};
    }

    location ~ /\.(?!well-known).* { deny all; }
}
