[mysqld]
basedir={{ basedir|p }}
datadir={{ datadir|p }}
{% if unix %}
socket={{ socket|p }}
{% endif %}
pid-file={{ pid|p }}
log-error={{ log|p }}
port={{ port }}
bind-address=127.0.0.1
character-set-server=utf8mb4
{% if engine == "mysql" %}
mysqlx=OFF
{% if linux %}
lc-messages-dir=/usr/share/mysql
{% endif %}
# without the full mysql-server package /var/lib/mysql-files does not exist and mysqld refuses to start
secure-file-priv=NULL
{% endif %}
