daemon off;
pid "{{ run_dir|p }}/nginx.pid";
error_log stderr warn;

events {
    worker_connections 768;
}

http {
    include "{{ etc_nginx|p }}/mime.types";
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;
    server_names_hash_bucket_size 128;

    access_log off;

    # WebSocket upgrades for proxied dev servers (Vite HMR, Next.js, Mailpit)
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    client_body_temp_path "{{ temp_dir|p }}/client_body";
    proxy_temp_path       "{{ temp_dir|p }}/proxy";
    fastcgi_temp_path     "{{ temp_dir|p }}/fastcgi";
    uwsgi_temp_path       "{{ temp_dir|p }}/uwsgi";
    scgi_temp_path        "{{ temp_dir|p }}/scgi";

    # Unknown site
    server {
        listen {{ listen }}{{ http_port }} default_server;
        server_name _;
        return 404 "PIPanel: site not found\n";
    }

{% for name, servers in upstreams.items() %}
    upstream {{ name }} {
{% for s in servers %}
        server {{ s }};
{% endfor %}
    }
{% endfor %}

    include "{{ sites_dir|p }}/*.conf";
}
